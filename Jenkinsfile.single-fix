// AI Single-Fix — separate parameterized Jenkins job
pipeline {
    agent any

    parameters {
        string(name: 'FILE_PATH', defaultValue: '', description: 'Finding file path')
        string(name: 'RULE_ID', defaultValue: '', description: 'Scanner rule/CVE')
        string(name: 'MESSAGE', defaultValue: '', description: 'Finding message')
        string(name: 'SOURCE', defaultValue: '', description: 'Scanner source')
        string(name: 'TICKET_ID', defaultValue: '', description: 'Dashboard finding ID')
        string(name: 'DASHBOARD_CALLBACK_URL', defaultValue: 'http://localhost:2001', description: 'Dashboard callback URL')
    }

    environment {
        GITHUB_REPOSITORY = 'KowshikaM/Shift_left_Devsecops'
        DASHBOARD_URL = "${params.DASHBOARD_CALLBACK_URL}"
        IMAGE_NAME = 'secure-devops-demo'
        KUBE_CONTEXT = 'kind-kind'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('AI Generate Patch') {
            steps {
                withCredentials([
                    string(credentialsId: 'openai-api-key', variable: 'OPENAI_API_KEY'),
                    string(credentialsId: 'groq-api-key', variable: 'GROQ_API_KEY')
                ]) {
                    powershell '''
                        Write-Host "Groq key loaded: $([string]::IsNullOrEmpty($env:GROQ_API_KEY) -eq $false)"
                        Write-Host "Groq key length: $($env:GROQ_API_KEY.Length)"
                        Write-Host "Groq key prefix: $($env:GROQ_API_KEY.Substring(0,4))"

                        python scripts/ai_fix_single.py `
                          --file "$env:FILE_PATH" `
                          --rule "$env:RULE_ID" `
                          --message "$env:MESSAGE" `
                          --ticket-id "$env:TICKET_ID"

                        if ($LASTEXITCODE -ne 0) {
                            exit $LASTEXITCODE
                        }
                    '''
                }
            }
        }

        stage('Validate AI Patch — Semgrep') {
            steps {
                powershell '''
                    $ErrorActionPreference = "Continue"

                    # Only validate the single file the AI was allowed to
                    # touch (see ai_fix_single.py's safe_path()). Scanning
                    # the whole app/ tree here would re-flag pre-existing,
                    # unrelated findings on every ticket and permanently
                    # block Security Gate regardless of what this specific
                    # patch changed.
                    $aiResult = Get-Content .ai-fix-result.json | ConvertFrom-Json
                    $targetFile = $aiResult.file
                    Write-Host "Semgrep target (AI-modified file only): $targetFile"

                    docker run --rm `
                      -v "${env:WORKSPACE}:/src" `
                      returntocorp/semgrep `
                      semgrep scan `
                      --config p/owasp-top-ten `
                      --config p/javascript `
                      --json `
                      --output /src/semgrep-results.json `
                      "/src/$targetFile" 2>&1 | Out-String | Write-Host

                    $code = $LASTEXITCODE
                    Write-Host "Semgrep exit code: $code"

                    if (!(Test-Path "semgrep-results.json")) {
                        '{}' | Set-Content semgrep-results.json
                    }

                    # Semgrep exit codes:
                    #   0 = no findings
                    #   1 = findings present (still valid JSON output)
                    #   2+ = scanner/runtime error
                    #
                    # Exit code 1 is intentionally allowed through so that
                    # the Security Gate evaluates the actual findings.
                    # $LASTEXITCODE is NOT reset by the checks above, so we
                    # must exit explicitly here -- otherwise Jenkins treats
                    # the step itself as failed because it inherits whatever
                    # $LASTEXITCODE the docker command last left behind.
                    if ($code -ge 2) {
                        Write-Host "Semgrep execution failed."
                        exit $code
                    }

                    Write-Host "Semgrep validation stage completed."
                    exit 0
                '''
            }
        }

        stage('Validate AI Patch — Gitleaks') {
            steps {
                powershell '''
                    $ErrorActionPreference = "Continue"

                    Write-Host "Running Gitleaks validation..."

                    # Same reasoning as the Semgrep stage above: only scan
                    # the single file the AI was allowed to touch, not the
                    # whole repo, so pre-existing/unrelated findings don't
                    # block every ticket forever.
                    $aiResult = Get-Content .ai-fix-result.json | ConvertFrom-Json
                    $targetFile = $aiResult.file
                    Write-Host "Gitleaks target (AI-modified file only): $targetFile"

                    docker run --rm `
                        -v "${env:WORKSPACE}:/repo" `
                        zricethezav/gitleaks:latest `
                        detect `
                        --source "/repo/$targetFile" `
                        --no-git `
                        --report-format json `
                        --report-path /repo/gitleaks-results.json `
                        *> gitleaks-console.log

                    $code = $LASTEXITCODE

                    Write-Host "Gitleaks exit code: $code"

                    if (!(Test-Path "gitleaks-results.json")) {
                        '[]' | Set-Content gitleaks-results.json
                    }

                    # Gitleaks:
                    #   0 = no leaks
                    #   1 = leaks found
                    #   2+ = scanner/runtime error
                    #
                    # Exit code 1 is intentionally allowed so that the
                    # Security Gate can evaluate the actual findings.
                    # $LASTEXITCODE is NOT reset by the checks above, so we
                    # must exit explicitly here -- otherwise Jenkins treats
                    # the step itself as failed because it inherits whatever
                    # $LASTEXITCODE the docker command last left behind.
                    if ($code -ge 2) {
                        Write-Host "Gitleaks execution failed."
                        Get-Content gitleaks-console.log
                        exit $code
                    }   

                    if ($code -eq 1) {
                        Write-Host "Gitleaks found potential secrets."
                        Write-Host "Security Gate will evaluate the findings."
                    } else {
                        Write-Host "Gitleaks found no secrets."
                    }

                    Write-Host "Gitleaks validation stage completed."
                    exit 0
                '''
            }
        }

        stage('Validate AI Patch — Docker/Trivy/OPA') {
            steps {
                powershell '''
                    $ErrorActionPreference = "Continue"

                    docker build -t "$env:IMAGE_NAME:ai-$env:BUILD_NUMBER" .

                    if ($LASTEXITCODE -ne 0) {
                        exit $LASTEXITCODE
                    }

                    docker save `
                      "$env:IMAGE_NAME:ai-$env:BUILD_NUMBER" `
                      -o "${env:WORKSPACE}\trivy-image.tar"

                    if ($LASTEXITCODE -ne 0) {
                        exit $LASTEXITCODE
                    }

                    docker run --rm `
                      -v "${env:WORKSPACE}:/out" `
                      aquasec/trivy:latest `
                      image `
                      --input /out/trivy-image.tar `
                      --format json `
                      --output /out/trivy-results.json `
                      --severity CRITICAL,HIGH,MEDIUM `
                      --timeout 10m

                    $trivyCode = $LASTEXITCODE

                    if (!(Test-Path "trivy-results.json")) {
                        '{}' | Set-Content trivy-results.json
                    }

                    if ($trivyCode -ge 2) {
                        exit $trivyCode
                    }

                    docker run --rm `
                      -v "${env:WORKSPACE}:/project" `
                      openpolicyagent/conftest `
                      test `
                      /project/Dockerfile `
                      --policy /project/policy `
                      --output json |
                      Set-Content dockerfile-policy-results.json

                    $d = $LASTEXITCODE

                    docker run --rm `
                      -v "${env:WORKSPACE}:/project" `
                      openpolicyagent/conftest `
                      test `
                      /project/k8s/deployment.yaml `
                      --policy /project/policy `
                      --output json |
                      Set-Content k8s-policy-results.json

                    $k = $LASTEXITCODE

                    if (!(Test-Path "dockerfile-policy-results.json")) {
                        '[]' | Set-Content dockerfile-policy-results.json
                    }

                    if (!(Test-Path "k8s-policy-results.json")) {
                        '[]' | Set-Content k8s-policy-results.json
                    }

                    # conftest exit codes:
                    #   0 = no policy violations
                    #   1 = policy violations found (still valid JSON output)
                    #   2+ = scanner/runtime error
                    #
                    # Exit code 1 is intentionally allowed through so the
                    # Security Gate evaluates the actual findings. As with
                    # the Semgrep/Gitleaks stages, $LASTEXITCODE is not
                    # reset by the checks above, so we exit explicitly.
                    if ($d -ge 2 -or $k -ge 2) {
                        exit 2
                    }

                    Remove-Item "trivy-image.tar" -Force -ErrorAction SilentlyContinue

                    Write-Host "Docker/Trivy/OPA validation stage completed."
                    exit 0
                '''
            }
        }

        stage('Security Gate') {
            steps {
                powershell '''
                    New-Item -ItemType Directory -Force -Path .scan-status | Out-Null

                    '0' | Set-Content .scan-status/semgrep.status
                    '0' | Set-Content .scan-status/gitleaks.status
                    '0' | Set-Content .scan-status/trivy.status
                    '0' | Set-Content .scan-status/docker-policy.status
                    '0' | Set-Content .scan-status/k8s-policy.status

                    python scripts/evaluate_gate.py

                    if ($LASTEXITCODE -ne 0) {
                        exit $LASTEXITCODE
                    }
                '''
            }
        }

        stage('Create Validated Branch and PR') {
            steps {
                withCredentials([
                    string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')
                ]) {
                    powershell '''
                        $result = Get-Content .ai-fix-result.json | ConvertFrom-Json

                        $branch = "ai-fix-ticket-$env:TICKET_ID-$($env:GIT_COMMIT.Substring(0,8))"

                        git config user.name "security-bot"
                        git config user.email "security-bot@users.noreply.github.com"

                        git checkout -b $branch

                        git add -- $env:FILE_PATH

                        git commit -m "fix: AI remediation for ticket #$env:TICKET_ID"

                        if ($LASTEXITCODE -ne 0) {
                            exit $LASTEXITCODE
                        }

                        # Use the Jenkins GitHub token explicitly for the push.
                        git -c "http.extraheader=AUTHORIZATION: bearer $env:GITHUB_TOKEN" `
                            push -u origin $branch

                        if ($LASTEXITCODE -ne 0) {
                            exit $LASTEXITCODE
                        }

                        "AI_BRANCH=$branch" |
                            Out-File -FilePath ai-pr.env -Encoding ascii

                        "AI_EXPLANATION=$($result.explanation)" |
                            Add-Content ai-pr.env

                        "AI_PROVIDER=$($result.provider)" |
                            Add-Content ai-pr.env
                    '''
                }

                script {
                    def vars = readFile('ai-pr.env').readLines()

                    vars.each { line ->
                        def i = line.indexOf('=')

                        if (i > 0) {
                            env[line.substring(0, i)] = line.substring(i + 1)
                        }
                    }
                }
            }
        }

        stage('Open GitHub PR') {
            steps {
                withCredentials([
                    string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')
                ]) {
                    powershell '''
                        python scripts/create_ai_pr.py

                        if ($LASTEXITCODE -ne 0) {
                            exit $LASTEXITCODE
                        }
                    '''
                }
            }
        }
    }

    post {
        always {
            echo "AI single-fix job finished for ticket #${params.TICKET_ID}"
        }
    }
}