// Existing parameterized AI remediation job, controlled by the Python agent.

pipeline {
    agent any

    parameters {
        string(name: 'FILE_PATH', defaultValue: '', description: 'Scanner-reported file path')
        string(name: 'RULE_ID', defaultValue: '', description: 'Scanner rule or vulnerability ID')
        string(name: 'MESSAGE', defaultValue: '', description: 'Scanner finding description')
        string(name: 'SOURCE', defaultValue: '', description: 'Scanner source')
        string(name: 'SEVERITY', defaultValue: '', description: 'Finding severity; only LOW/MEDIUM are eligible')
        string(name: 'GROQ_MODEL', defaultValue: 'openai/gpt-oss-20b', description: 'Groq model ID')
        string(name: 'VULNERABILITY_ID', defaultValue: '', description: 'CVE or scanner finding ID')
        string(name: 'PACKAGE_NAME', defaultValue: '', description: 'Affected package, when available')
        string(name: 'INSTALLED_VERSION', defaultValue: '', description: 'Installed package version, when available')
        string(name: 'FIXED_VERSION', defaultValue: '', description: 'Scanner-recommended fixed version, when available')
        string(name: 'TICKET_ID', defaultValue: '', description: 'Dashboard finding ID')
    }

    environment {
        GITHUB_REPOSITORY = 'KowshikaM/Shift_left_Devsecops'
        DASHBOARD_CALLBACK_URL = 'http://localhost:2001'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('AI Generate Patch') {
            steps {
                withCredentials([string(credentialsId: 'groq-api-key', variable: 'GROQ_API_KEY')]) {
                    withEnv(["GROQ_MODEL=${params.GROQ_MODEL}"]) {
                        powershell '''
                        foreach ($name in @('FILE_PATH', 'RULE_ID', 'TICKET_ID', 'SOURCE', 'SEVERITY')) {
                            if ([string]::IsNullOrWhiteSpace([Environment]::GetEnvironmentVariable($name))) {
                                throw "Required AI remediation parameter is empty: $name"
                            }
                        }

                        $agentArgs = @(
                            '--file', $env:FILE_PATH,
                            '--rule', $env:RULE_ID,
                            '--ticket-id', $env:TICKET_ID,
                            '--source', $env:SOURCE,
                            '--severity', $env:SEVERITY
                        )

                        if (![string]::IsNullOrWhiteSpace($env:MESSAGE)) {
                            $agentArgs += @('--message', $env:MESSAGE)
                        }
                        if (![string]::IsNullOrWhiteSpace($env:VULNERABILITY_ID)) {
                            $agentArgs += @('--vulnerability-id', $env:VULNERABILITY_ID)
                        }
                        if (![string]::IsNullOrWhiteSpace($env:PACKAGE_NAME)) {
                            $agentArgs += @('--package-name', $env:PACKAGE_NAME)
                        }
                        if (![string]::IsNullOrWhiteSpace($env:INSTALLED_VERSION)) {
                            $agentArgs += @('--installed-version', $env:INSTALLED_VERSION)
                        }
                        if (![string]::IsNullOrWhiteSpace($env:FIXED_VERSION)) {
                            $agentArgs += @('--fixed-version', $env:FIXED_VERSION)
                        }

                        & python scripts/ai_remediation_agent.py @agentArgs

                        if ($LASTEXITCODE -ne 0) {
                            exit $LASTEXITCODE
                        }
                        '''
                    }
                }
            }
        }

        stage('Validate AI Patch — Semgrep') {
            steps {
                powershell '''
                    $result = Get-Content ".ai-fix-result.json" -Raw | ConvertFrom-Json
                    if ($result.status -eq "PASS") {
                        if (!(Test-Path ".ai-remediation/after/semgrep-results.json")) {
                            throw "Post-remediation Semgrep evidence is missing."
                        }
                        Write-Host "Semgrep post-remediation scan completed by the Python controller."
                    } else {
                        Write-Host "Agent stopped safely; Semgrep was not reported as passed."
                    }
                '''
            }
        }

        stage('Validate AI Patch — Gitleaks') {
            steps {
                powershell '''
                    $result = Get-Content ".ai-fix-result.json" -Raw | ConvertFrom-Json
                    if ($result.status -eq "PASS") {
                        if (!(Test-Path ".ai-remediation/after/gitleaks-results.json")) {
                            throw "Post-remediation Gitleaks evidence is missing."
                        }
                        Write-Host "Gitleaks post-remediation scan completed by the Python controller."
                    } else {
                        Write-Host "Agent stopped safely; Gitleaks was not reported as passed."
                    }
                '''
            }
        }

        stage('Validate AI Patch — Docker/Trivy/OPA') {
            steps {
                powershell '''
                    $result = Get-Content ".ai-fix-result.json" -Raw | ConvertFrom-Json
                    if ($result.status -eq "PASS") {
                        $reports = @(
                            ".ai-remediation/after/trivy-results.json",
                            ".ai-remediation/after/dockerfile-policy-results.json",
                            ".ai-remediation/after/k8s-policy-results.json"
                        )
                        foreach ($report in $reports) {
                            if (!(Test-Path $report)) { throw "Post-remediation evidence missing: $report" }
                        }
                        Write-Host "Trivy and both OPA/Conftest post-remediation scans completed by the Python controller."
                    } else {
                        Write-Host "Agent stopped safely; container/policy scans were not reported as passed."
                    }
                '''
            }
        }

        stage('Security Gate') {
            steps {
                powershell '''
                    $result = Get-Content ".ai-fix-result.json" -Raw | ConvertFrom-Json
                    $result.status | Set-Content "gate-status.txt"
                    Write-Host "Remediation verification status: $($result.status)"
                    Write-Host "Test status: $($result.test_status)"
                    Write-Host "Rescan status: $($result.rescan_status)"
                    Write-Host "Main release gate remains enforced by the secure-devops-pipeline job."
                '''
            }
        }

        stage('Update Ticket Validation Status') {
            steps {
                withCredentials([string(credentialsId: 'dashboard-callback-token', variable: 'DASHBOARD_CALLBACK_TOKEN')]) {
                    powershell '''
                        python scripts/dashboard_callback.py validation-result .ai-fix-result.json
                        if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
                    '''
                }
            }
        }

        stage('Create Validated Branch and PR') {
            when {
                expression { return fileExists('gate-status.txt') && readFile('gate-status.txt').trim() == 'PASS' }
            }
            steps {
                withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                    powershell '''
                        $result = Get-Content ".ai-fix-result.json" -Raw | ConvertFrom-Json
                        $branch = [string]$result.branch
                        if ($branch -notmatch '^ai-remediation/ticket-[0-9]+-[0-9]+$') {
                            throw "Agent returned an invalid isolated branch name."
                        }
                        git -c "http.extraheader=AUTHORIZATION: bearer $env:GITHUB_TOKEN" push -u origin $branch
                        if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
                        $branch | Set-Content "ai-branch.txt"
                    '''
                }
                script {
                    env.AI_BRANCH = readFile('ai-branch.txt').trim()
                }
            }
        }

        stage('Open GitHub PR') {
            when {
                expression { return fileExists('gate-status.txt') && readFile('gate-status.txt').trim() == 'PASS' }
            }
            steps {
                withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                    withCredentials([string(credentialsId: 'dashboard-callback-token', variable: 'DASHBOARD_CALLBACK_TOKEN')]) {
                        powershell '''
                            python scripts/create_ai_pr.py
                            if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
                        '''
                    }
                }
            }
        }

        stage('Finalize Validation Result') {
            steps {
                script {
                    if (!fileExists('gate-status.txt')) {
                        error('Remediation result is missing; manual review is required.')
                    }
                    def status = readFile('gate-status.txt').trim()
                    echo "AI remediation result: ${status}"
                    if (status != 'PASS') {
                        currentBuild.result = 'FAILURE'
                        error('AI remediation was not validated. The original file was preserved or restored; review dashboard evidence.')
                    }
                    echo 'Validated branch and PR are ready for human review. No merge or deployment was performed.'
                }
            }
        }
    }

    post {
        always { echo "AI remediation job finished for ticket #${params.TICKET_ID}" }
        failure { echo 'Remediation failed validation or requires manual review.' }
    }
}
